---
import { getCollection } from 'astro:content';
import Hero from '../components/Hero.astro';
import { siteConfig } from '../data/site';
import { getPostPermalink, getPublishedPosts } from '../lib/blog';
import BaseLayout from '../layouts/BaseLayout.astro';

const featuredPosts = getPublishedPosts(await getCollection('blog'))
  .filter((post) => post.data.featured)
  .map((post) => ({
    title: post.data.title,
    description: post.data.description,
    permalink: getPostPermalink(post)
  }));
---

<BaseLayout title={siteConfig.title} description={siteConfig.description} bodyClass="home-page" showFooter={false}>
  <Hero featuredPosts={featuredPosts} />
</BaseLayout>
